// ===== PHASE 2: AFTER RESOLVE (maps to conflict commits + gates) =====
// Symbols S1.. / Sj are *earned* -- analogous to post-discovery grid attractors.
after resolve V {

  // Pre-commit honesty (CONFIGURATOR PREVIEW): inspect before treat-as-real
  // Last R_arb winner in this match: Alpha
  send Alpha[S1] -> basin_center
  expect basin_center[Sj] within 500ms, fidelity: 0.85

  // Ternary coherence gate ~ CONFIGURATOR HOLD / commit / back-off
  // NOTE: SymLan HOLD is NOT Basin action HOLD (namespaces stay separate)
  branch on T(basin_center, V) {
    > 1.02 : reverse basin_center;  // over-coupled / unsafe commit
    ~ 1.0  : proceed Alpha[S1]; // near band -- commit scar
    < 0.98 : hold;                  // under-resolved -- wait (legal)
  }
}

// ===== ROSETTA (CONFIGURATOR -> SymLan) =====
