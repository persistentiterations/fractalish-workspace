// ===== PHASE 1: ARENA (maps to match open + discovery rounds) =====
node Alpha, Beta, Gamma, Delta
node basin_center  // conflict target (grid center)

Alpha -> basin_center [kappa: 0.50, phi: pi/4, T: 1.0]  // witness ladder slot 0: 1/2  (book form: kappa->k, phi->phi, T)
Beta -> basin_center [kappa: 0.33, phi: pi/5, T: 1.0]  // witness ladder slot 1: 1/3  (book form: kappa->k, phi->phi, T)
Gamma -> basin_center [kappa: 0.25, phi: pi/6, T: 1.0]  // witness ladder slot 2: 1/4  (book form: kappa->k, phi->phi, T)
Delta -> basin_center [kappa: 0.17, phi: 3*pi/8, T: 1.0]  // witness ladder slot 3: 1/6  (book form: kappa->k, phi->phi, T)

vocab V = register(basin_center, theta: auto, features: 7D)
